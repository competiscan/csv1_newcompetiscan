<VirtualHost *:80>
    ServerName demo1.competiscan.com
    ServerAlias www.demo1.competiscan.com

    DocumentRoot /srv/httpd/competiscan.com/html/wordpress
    DirectoryIndex index.php index.html

    <Directory /srv/httpd/competiscan.com/html/wordpress>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # PHP-FPM via SOCKET (PHP 8.2)
    <FilesMatch \.php$>
        SetHandler "proxy:unix:/var/opt/remi/php82/run/php-fpm/www.sock|fcgi://localhost/"
    </FilesMatch>

    # ✅ FIXED PATH (must match DocumentRoot)
    ProxyFCGISetEnvIf "true" SCRIPT_FILENAME "/srv/httpd/competiscan.com/html/wordpress%{REQUEST_URI}"

    ErrorLog /var/log/httpd/competiscan-error.log
    CustomLog /var/log/httpd/competiscan-access.log combined
</VirtualHost>
